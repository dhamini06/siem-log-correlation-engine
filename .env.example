# SIEM Lab environment variables (copy to .env and adjust as needed)
# Python reads these directly from the process environment:
#   $env:ES_HOST = "localhost"   # PowerShell session
#   setx ES_HOST "localhost"     # persistent

# Elasticsearch connection (local lab defaults: no auth, single node)
ES_HOST=localhost
ES_PORT=9200
KIBANA_URL=http://localhost:5601

# Logging
LOG_LEVEL=INFO

# Correlation rule overrides (optional; config/app-config.yaml is the source of truth)
RULE_MIN_FAILURES=5
RULE_TIME_WINDOW_MINUTES=5

# Production placeholders - NOT enabled for the local lab.
#
# Enabling xpack security is deliberately NOT part of the current deployment
# work. src/elasticsearch_client.py has no TLS or credential support at all, so
# turning security on would disconnect the Python engine rather than protect it;
# that is a later phase, and docs/DEPLOYMENT_MODES.md records it as open.
# ES_CA_CERT below is therefore a placeholder for that future phase, and its
# value is a server path rather than the Windows one it used to show.
# ES_USERNAME=siem_engine
# ES_PASSWORD=change-me
# ES_CA_CERT=/opt/siem-lab07/certs/ca.crt

# --- Kibana encryption keys -------------------------------------------------
# docker-compose.yml REQUIRES these three. There is no fallback value any more:
# the fixed defaults that used to sit in the compose file were published in this
# repository, so anyone who could read it could decrypt Kibana sessions and
# encrypted saved objects. Compose now stops with an explicit error when one is
# missing.
#
# You normally do not need to touch this file. scripts/setup.ps1 and
# scripts/start_lab.ps1 create a .env containing three random keys on first run,
# and .env is git-ignored. The placeholders below are NOT valid keys and exist
# only to show the shape of the file.
#
# To supply your own, generate three unique values:
#   docker compose run --rm kibana bin/kibana-encryption-keys
# Real values belong in .env, which git ignores. Never put them in this file.
# SIEM_ENCRYPTION_KEY=<at-least-32-characters>
# SIEM_ESO_ENCRYPTION_KEY=<at-least-32-characters>
# SIEM_REPORTING_ENCRYPTION_KEY=<at-least-32-characters>

#
# Rotating these after Kibana has run invalidates the existing saved objects
# stored in the kibana-config volume, so re-import the dashboard afterwards:
#   python -m src.main import-dashboard
SIEM_ENCRYPTION_KEY=
SIEM_ESO_ENCRYPTION_KEY=
SIEM_REPORTING_ENCRYPTION_KEY=

# --- Server deployment --------------------------------------------------------
# On the shared server the three keys above MUST be generated on that host:
#
#   docker compose run --rm kibana bin/kibana-encryption-keys
#
# Do not copy a workstation .env onto the server. The lab's Compose project is
# namespaced (project bcssl-siem-lab07), so a server .env and a workstation .env
# are two different sets of keys guarding two different saved-object stores.
# Copying one means both hosts can decrypt each other's Kibana sessions.
#
# See docs/SERVER_DEPLOYMENT.md.
