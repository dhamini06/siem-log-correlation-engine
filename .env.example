# SIEM Lab environment variables (copy to .env and adjust as needed)
# Python reads these directly from the process environment:
#   $env:ES_HOST = "localhost"   # PowerShell session
#   setx ES_HOST "localhost"     # persistent

# Elasticsearch connection (local lab defaults: no auth, single node)
ES_HOST=localhost
ES_PORT=9200
KIBANA_URL=http://localhost:5601

# Logging
LOG_LEVEL=INFO

# Correlation rule overrides (optional; config/app-config.yaml is the source of truth)
RULE_MIN_FAILURES=5
RULE_TIME_WINDOW_MINUTES=5

# Production placeholders - NOT enabled for the local lab.
# Enable xpack security on Elasticsearch and Kibana before using these.
# ES_USERNAME=siem_engine
# ES_PASSWORD=change-me
# ES_CA_CERT=C:\certs\ca.crt

# --- Kibana encryption keys -------------------------------------------------
# docker-compose.yml interpolates these three variables and falls back to clearly
# labelled local-development placeholders, so the lab runs with no .env at all.
#
# That is safe for a throwaway lab and MUST NOT be used for a real deployment:
# the defaults are public in this repository, and Kibana uses these keys to
# decrypt sessions and encrypted saved objects. Anyone who knows the value can
# read that data.
#
# Before deploying anywhere beyond localhost, generate three unique keys:
#   docker compose run --rm kibana bin/kibana-encryption-keys
# then set the output here (real values go in a git-ignored .env, never in this file):
# SIEM_ENCRYPTION_KEY=<at-least-32-characters>
# SIEM_ESO_ENCRYPTION_KEY=<at-least-32-characters>
# SIEM_REPORTING_ENCRYPTION_KEY=<at-least-32-characters>
#
# Rotating these after Kibana has run invalidates the existing saved objects
# stored in the kibana-config volume, so re-import the dashboard afterwards:
#   python -m src.main import-dashboard
SIEM_ENCRYPTION_KEY=
SIEM_ESO_ENCRYPTION_KEY=
SIEM_REPORTING_ENCRYPTION_KEY=
