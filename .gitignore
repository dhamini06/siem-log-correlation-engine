# ---------------------------------------------------------------------------
# SIEM Log Correlation Engine - Lab #07
# Only source, configuration, documentation, tests and the training platform
# belong in version control. Everything listed below is either regenerable,
# machine-specific, or a secret.
# ---------------------------------------------------------------------------

# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
ENV/
.python-version
.mypy_cache/
.ruff_cache/
.pytest_cache/
.cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.egg-info/
build/
dist/
.eggs/

# --- Runtime state (regenerated by generate-samples / the engine) -----------
/data/
*.bak
*.tmp
*~
nohup.out

# --- Logs -------------------------------------------------------------------
# logs/samples/ is deliberately tracked: it is the hand-inspectable reference
# fixture for each supported log format. The application log and the
# generator output are not.
/logs/app.log
/logs/app.log.*
/logs/generated/
*.pid

# --- Secrets ----------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
credentials/
# Local-only compose overrides and generated certs
docker-compose.override.yml
config/certs/

# --- Test / coverage output -------------------------------------------------
junit.xml
*.lcov
.nyc_output/

# --- Editors / IDE ----------------------------------------------------------
.vscode/
.idea/
*.iml
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- OS ---------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
Desktop.ini
$RECYCLE.BIN/
*.lnk

# --- Local installers and vendor downloads ---------------------------------
# Docker Desktop / other installers are machine-specific, hundreds of MB, and
# are not part of the project.
*.exe
*.msi
*.msix
*.dmg
*.pkg
*.deb
*.rpm

# --- Working documents from the build session -------------------------------
# The lab specification/brief used during development, kept out of the public
# repository. Full documentation lives in docs/.
MASTER_PROMPT.md
